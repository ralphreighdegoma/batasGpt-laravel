{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "afsakar/filament-otp-login": "^1.3",
        "chillerlan/php-qrcode": "^5.0",
        "fakerphp/faker": "^1.23",
        "filament/filament": "^3.2",
        "filament/forms": "^3.2",
        "hasnayeen/themes": "^3.0",
        "jiten14/jitone-ai": "^0.1.5",
        "joaopaulolndev/filament-edit-profile": "^1.0",
        "lara-zeus/boredom": "^1.0",
        "laravel/framework": "^11.9",
        "laravel/passport": "^12.4",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.0",
        "openai-php/client": "^0.10.3",
        "parallax/filament-comments": "^1.3",
        "pusher/pusher-php-server": "^7.2",
        "saade/filament-fullcalendar": "^3.0",
        "tapp/filament-google-autocomplete-field": "^1.0",
        "ysfkaya/filament-phone-input": "^3.1"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.38",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.1",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
